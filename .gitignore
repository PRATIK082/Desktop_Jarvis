# =============================================================================
# JARVIS Desktop — .gitignore
# =============================================================================

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
log.txt

# --- Node / npm ---
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tgz
package-lock.json
pnpm-lock.yaml
yarn.lock
.npm/
.npmrc

# --- Vite / frontend ---
**/dist/
**/dist-ssr/
*.local

# --- Tauri ---
**/target/
**/gen/

# --- Python ---
**/__pycache__/
**/*.tsbuildinfo
**/*.egg-info/
**/*.py[cod]
**/*$py.class
**/*.so
.Python
**/env/
**/venv/
**/.venv/
pip-log.txt
pip-delete-this-directory.txt
**/.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
**/.pytest_cache/

# pyenv
.python-version

# --- Environment / secrets (never commit) ---
.env
.env.local
.env.*.local
secrets/
*.key
*.pem

# --- JARVIS data (local-only, never committed) ---
.jarvis/
*.db
*.db-shm
*.db-wal
*.sqlite
logs/
*.log

# --- IDE ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# --- Build / packaging ---
*.msi
*.exe
*.dmg
*.pkg
*.deb
*.rpm
appx/
app.build/

# --- OpenCode environment (not project source) ---
.opencode/

# --- Misc ---
.turbo/


# --- AI agent / tooling (local only, never committed) ---
Agent.md
AGENTS.md
CLAUDE.md
opencode.json
.cursor/
.claude/
.serena/
.opencode/

# --- Internal docs / working notes (local only) ---
docs/
CONTRIBUTING.md
FINAL_REPORT.md
HOW_TO_RUN.md
PRIVACY.md
PROGRESS.md
SECURITY.md

# Tauri default readme (junk)
apps/desktop/src-tauri/README.md
services/assistant/README.md
