{
  "name": "desktop-jarvis",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Privacy-first local desktop voice assistant (Tauri 2 + React + Python sidecar + Ollama)",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/desktop",
    "packages/contracts",
    "packages/ui"
  ],
  "scripts": {
    "bootstrap": "npm install && npm --prefix apps/desktop install && npm --prefix packages/contracts install",
    "dev": "npm run dev --workspace=apps/desktop",
    "dev:tauri": "npm run tauri dev --workspace=apps/desktop",
    "build": "npm run build --workspaces",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "tauri": "npm run tauri --workspace=apps/desktop",
    "test": "npm test --workspaces",
    "test:frontend": "npm test --workspace=apps/desktop",
    "test:backend": "npm test --workspace=services/assistant",
    "lint": "npm run lint --workspaces",
    "lint:frontend": "npm run lint --workspace=apps/desktop",
    "lint:backend": "npm run lint --workspace=services/assistant",
    "format": "npm run format --workspaces",
    "format:frontend": "npm run format --workspace=apps/desktop",
    "doctor": "node scripts/doctor.js",
    "clean": "npm run clean --workspaces",
    "package:desktop": "npm run tauri build --workspace=apps/desktop"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "eslint": "^9.17.0",
    "typescript": "~5.7.2"
  }
}
