.env.example

# JARVIS Desktop environment configuration
# Copy this file to .env and adjust as needed. Never commit real secrets.

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=

# Sidecar
JARVIS_HOST=127.0.0.1
JARVIS_PORT=0  # 0 = ephemeral free port chosen by Tauri
JARVIS_LOG_LEVEL=info

# Audio
JARVIS_VAD_AGGRESSIVENESS=2
JARVIS_SILENCE_TIMEOUT_MS=800
JARVIS_INTERUPTION_ENABLED=true

# Wake word (optional)
JARVIS_WAKE_WORD_ENABLED=false
JARVIS_WAKE_WORD_SENSITIVITY=0.5

# Privacy
JARVIS_TELEMETRY_ENABLED=false
JARVIS_RETAIN_RAW_AUDIO=false
